#!/usr/bin/python3
# omarchy:summary=Print the Spiritty usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Spiritty usage into one display-ready JSON record.

Everything the Omarchy agents panel shows for Spiritty comes from this one
command: local session files under ~/.config/spiritty/sessions/. Each session
JSON already carries per-session token totals and a single model, so the scan
is a straight aggregation by model and by day. The panel only ever reads the
JSON this prints; it never inspects Spiritty's own file layout.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import sys
from pathlib import Path
from typing import Any

AGENT_ID = "spiritty"
AGENT_NAME = "Spiritty"
RECENT_DAYS = 7

DATE_FORMATS = (
    "%Y-%m-%d %H:%M:%S",
    "%Y-%m-%d %H:%M",
    "%Y-%m-%dT%H:%M:%S",
    "%Y-%m-%dT%H:%M",
    "%Y-%m-%d",
)


def sessions_dir() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config")
    return Path(base) / "spiritty" / "sessions"


def parse_local_date(value: Any) -> dt.date | None:
    if not isinstance(value, str) or not value:
        return None
    for fmt in DATE_FORMATS:
        try:
            return dt.datetime.strptime(value, fmt).date()
        except ValueError:
            continue
    return None


def number(value: Any) -> int:
    try:
        n = float(value or 0)
    except (TypeError, ValueError):
        return 0
    return round(n) if n == n else 0


def empty_bucket() -> dict[str, int]:
    return {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    }


def recent_date_strings(days: int = RECENT_DAYS) -> list[str]:
    today = dt.date.today()
    return [(today - dt.timedelta(days=o)).isoformat() for o in range(days - 1, -1, -1)]


def empty_stats() -> dict[str, Any]:
    return {
        "todayPrompts": 0,
        "todaySessions": 0,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "recentDays": [{"date": d, "messageCount": 0} for d in recent_date_strings()],
        "modelUsage": {},
        "totalPrompts": 0,
        "totalSessions": 0,
        "activeDays": 0,
        "activeDates": [],
    }


def count_prompts(data: dict[str, Any]) -> int:
    history = data.get("prompt_history")
    if isinstance(history, list) and history:
        return len(history)
    messages = data.get("messages")
    if isinstance(messages, list):
        users = sum(1 for m in messages if isinstance(m, dict) and m.get("role") == "user")
        if users > 0:
            return users
    return 1  # a session file exists because at least one prompt ran in it


def scan_sessions(root: Path) -> dict[str, Any]:
    if not root.is_dir():
        return empty_stats()

    today = dt.date.today().isoformat()
    recent_dates = recent_date_strings()
    recent = {d: 0 for d in recent_dates}

    sessions_seen: set[str] = set()
    today_sessions: set[str] = set()
    active_days: set[str] = set()
    today_tokens_by_model: dict[str, int] = {}
    usage_by_model: dict[str, dict[str, int]] = {}

    prompts_total = 0
    today_prompts = 0
    today_token_total = 0

    for path in sorted(root.glob("*.json")):
        try:
            with path.open("r", encoding="utf-8", errors="replace") as handle:
                data = json.load(handle)
        except Exception as exc:
            print(f"Ignoring unreadable Spiritty session {path}: {exc}", file=sys.stderr)
            continue
        if not isinstance(data, dict):
            continue

        session_id = str(data.get("id") or path.stem)
        model = str(data.get("model") or "unknown")

        input_tokens = number(data.get("prompt_tokens"))
        output_tokens = number(data.get("completion_tokens"))
        total_tokens = number(data.get("total_tokens"))
        if total_tokens <= 0:
            total_tokens = input_tokens + output_tokens

        day = parse_local_date(data.get("updated_at")) or parse_local_date(data.get("created_at"))
        day_str = day.isoformat() if day else None
        prompt_count = count_prompts(data)

        sessions_seen.add(session_id)
        prompts_total += prompt_count
        if day_str:
            active_days.add(day_str)

        bucket = usage_by_model.setdefault(model, empty_bucket())
        bucket["inputTokens"] += input_tokens
        bucket["outputTokens"] += output_tokens

        if day_str in recent:
            # recentDays.messageCount is a token total despite the legacy name.
            recent[day_str] += total_tokens

        if day_str == today:
            today_sessions.add(session_id)
            today_prompts += prompt_count
            today_token_total += total_tokens
            today_tokens_by_model[model] = today_tokens_by_model.get(model, 0) + total_tokens

    return {
        "todayPrompts": today_prompts,
        "todaySessions": len(today_sessions),
        "todayTotalTokens": today_token_total,
        "todayTokensByModel": today_tokens_by_model,
        "recentDays": [{"date": d, "messageCount": recent[d]} for d in recent_dates],
        "modelUsage": usage_by_model,
        "totalPrompts": prompts_total,
        "totalSessions": len(sessions_seen),
        "activeDays": len(active_days),
        "activeDates": sorted(active_days),
    }


def build_record(stats: dict[str, Any]) -> dict[str, Any]:
    record: dict[str, Any] = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        "ready": number(stats.get("totalPrompts")) > 0,
        "hasLocalStats": True,
        "hasPromptStats": True,
        "tierLabel": "",
        "usageStatusText": "",
        "authHelpText": "",
        "limits": [],
    }
    record.update(stats)
    return record


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--limits-only", action="store_true")
    parser.add_argument("--cache-seconds", type=float, default=20)
    # Both flags are accepted for interface parity with the other collectors;
    # Spiritty keeps no remote rate limits, so they are effectively no-ops.
    parser.parse_args()

    stats = scan_sessions(sessions_dir())
    print(json.dumps(build_record(stats), separators=(",", ":"), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
